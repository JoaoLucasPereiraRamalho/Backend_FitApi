// Schema único, dividido por seções conforme os módulos (docs/ESTRUTURA.md, seção 6).
// Cada tabela pertence a um módulo. Instantes são timestamptz (UTC); datas locais são derivadas
// do fuso do aluno no momento do cálculo. IDs são UUID v7 gerados pela porta IdGenerator.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// identity
// =====================================================================

enum Role {
  TRAINER
  STUDENT
}

enum LoadUnit {
  KG
  LBS
}

enum TrainingLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id              String    @id @db.Uuid
  name            String
  email           String    @unique
  passwordHash    String?   @map("password_hash") // nulo para contas só com SSO
  role            Role
  timezone        String // nome IANA, ex.: America/Sao_Paulo
  loadUnit        LoadUnit  @default(KG) @map("load_unit")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt       DateTime  @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz // exclusão LGPD (anonimização)

  // Bloqueio após falhas seguidas de login (423 ACCOUNT_LOCKED); o limite vem da configuração.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz

  trainerProfile TrainerProfile?
  studentProfile StudentProfile?
  loginSessions  LoginSession[]
  devices        Device[]
  consents       Consent[]

  invitesCreated Invite[] @relation("InviteTrainer")
  invitesUsed    Invite[] @relation("InviteStudent")
  trainerLinks   Link[]   @relation("LinkTrainer")
  studentLinks   Link[]   @relation("LinkStudent")

  exercises            Exercise[]
  approvedAlternatives ExerciseAlternative[]
  mesocyclesOwned      Mesocycle[]           @relation("MesocycleOwner")
  mesocyclesPrescribed Mesocycle[]           @relation("MesocycleStudent")
  templates            Template[]

  executedSessions  ExecutedSession[]
  syncedMutations   SyncedMutation[]
  weekProgress      WeekProgress[]
  badges            StudentBadge[]
  loadConfirmations LoadConfirmation[]

  trainerNotesWritten    TrainerNote[]       @relation("TrainerNoteAuthor")
  trainerNotesAbout      TrainerNote[]       @relation("TrainerNoteStudent")
  bodyMeasurements       BodyMeasurement[]
  anamnesis              Anamnesis?
  anamnesisVersions      AnamnesisVersion[]
  healthDataOwned        HealthDataAccess[]  @relation("HealthDataOwner")
  healthDataRead         HealthDataAccess[]  @relation("HealthDataReader")
  conversationsAsTrainer Conversation[]      @relation("ConversationTrainer")
  conversationsAsStudent Conversation[]      @relation("ConversationStudent")
  messagesSent           Message[]
  notifications          Notification[]
  files                  StoredFile[]
  attachmentsReceived    StudentAttachment[] @relation("AttachmentStudent")
  attachmentsShared      StudentAttachment[] @relation("AttachmentTrainer")

  @@map("users")
}

model TrainerProfile {
  userId      String   @id @map("user_id") @db.Uuid
  cref        String
  specialties String[]
  plan        String   @default("PRO") // informativo, sem limite de alunos (RN01)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trainer_profiles")
}

model StudentProfile {
  userId    String         @id @map("user_id") @db.Uuid
  birthDate DateTime?      @map("birth_date") @db.Date
  heightCm  Int?           @map("height_cm")
  goal      String?
  level     TrainingLevel?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

enum ClientKind {
  WEB
  MOBILE
}

// Uma sessão de login é uma família de refresh tokens: cada refresh rotaciona o token dentro da
// mesma sessão. Reusar um token já rotacionado revoga a sessão inteira (401 REFRESH_REUSED).
model LoginSession {
  id           String     @id @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  client       ClientKind
  userAgent    String?    @map("user_agent")
  createdAt    DateTime   @map("created_at") @db.Timestamptz
  lastUsedAt   DateTime   @map("last_used_at") @db.Timestamptz
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz
  revokedAt    DateTime?  @map("revoked_at") @db.Timestamptz
  revokeReason String?    @map("revoke_reason") // LOGOUT, LOGOUT_ALL, REUSE, PASSWORD_RESET, ACCOUNT_DELETED

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("login_sessions")
}

// Só o hash do token é guardado. usedAt preenchido = já rotacionado.
model RefreshToken {
  id        String    @id @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @map("created_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz

  session LoginSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum DevicePlatform {
  ANDROID
  IOS
}

// Aparelho com token de push. O token é único: se outra conta entrar no mesmo aparelho, a linha
// muda de dono em vez de duplicar.
model Device {
  id         String         @id @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  pushToken  String         @unique @map("push_token")
  platform   DevicePlatform
  appVersion String         @map("app_version")
  createdAt  DateTime       @map("created_at") @db.Timestamptz
  lastSeenAt DateTime       @map("last_seen_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

enum ConsentType {
  TERMS_OF_USE
  PRIVACY_POLICY
  HEALTH_DATA
  COMMUNICATION
}

// Histórico de aceites (LGPD): uma linha por aceite ou revogação de uma versão do documento.
// Nova versão da política gera nova linha; nenhuma linha é alterada além de revokedAt.
model Consent {
  id        String      @id @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  type      ConsentType
  version   String
  grantedAt DateTime    @map("granted_at") @db.Timestamptz
  revokedAt DateTime?   @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, grantedAt])
  @@map("consents")
}

// Parâmetros de negócio que a ERS pede que não fiquem fixos no código (exposto em GET /config).
// Lido pela interface pública de identity (SystemSettings).
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}

// =====================================================================
// linking
// =====================================================================

// PENDING passado de expiresAt é tratado como expirado pelo caso de uso mesmo antes de ser
// marcado EXPIRED; a expiração vem de system_settings (inviteExpiresInDays).
enum InviteStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

model Invite {
  id           String       @id @db.Uuid
  trainerId    String       @map("trainer_id") @db.Uuid
  code         String       @unique // código curto digitado no app, ex.: TJ-9812
  tokenHash    String       @unique @map("token_hash") // hash do token do link; o token nunca é guardado
  invitedEmail String?      @map("invited_email")
  status       InviteStatus @default(PENDING)
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz
  createdAt    DateTime     @map("created_at") @db.Timestamptz
  usedAt       DateTime?    @map("used_at") @db.Timestamptz
  usedById     String?      @map("used_by_id") @db.Uuid
  revokedAt    DateTime?    @map("revoked_at") @db.Timestamptz

  trainer User  @relation("InviteTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  usedBy  User? @relation("InviteStudent", fields: [usedById], references: [id], onDelete: SetNull)
  link    Link?

  @@index([trainerId, status, createdAt])
  @@map("invites")
}

enum LinkStatus {
  ACTIVE
  ENDED
}

enum LinkEndedBy {
  TRAINER
  STUDENT
  SYSTEM
}

// Vínculo treinador-aluno. Encerrar muda o status e mantém a linha (RN02: o histórico fica).
// Um aluno tem no máximo um vínculo ACTIVE: índice único parcial links_one_active_per_student,
// criado em SQL na migração porque o Prisma não declara índices parciais.
model Link {
  id        String       @id @db.Uuid
  trainerId String       @map("trainer_id") @db.Uuid
  studentId String       @map("student_id") @db.Uuid
  inviteId  String?      @unique @map("invite_id") @db.Uuid
  status    LinkStatus   @default(ACTIVE)
  startedAt DateTime     @map("started_at") @db.Timestamptz
  endedAt   DateTime?    @map("ended_at") @db.Timestamptz
  endedBy   LinkEndedBy? @map("ended_by")

  trainer      User          @relation("LinkTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  student      User          @relation("LinkStudent", fields: [studentId], references: [id], onDelete: Restrict)
  invite       Invite?       @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  conversation Conversation?

  @@index([trainerId, status])
  @@index([studentId, startedAt])
  @@map("links")
}

// =====================================================================
// library
// =====================================================================

// Catálogos com chave estável (usada pelos clientes e pelos filtros) e rótulo exibido.
model MuscleGroup {
  key       String @id // ex.: CHEST
  label     String
  sortOrder Int    @map("sort_order")

  exercises Exercise[]

  @@map("muscle_groups")
}

model Equipment {
  key       String @id // ex.: BARBELL
  label     String
  sortOrder Int    @map("sort_order")

  exercises Exercise[]

  @@map("equipment")
}

// Dono nulo = exercício base (somente leitura). Personalizados são do treinador ou do aluno
// autônomo que os criou. Excluir é lógico (deletedAt), porque fichas antigas continuam apontando
// para o exercício (RN05). Nome único por dono entre os não excluídos e badgeKey só em base:
// regras em SQL na migração.
model Exercise {
  id             String    @id @db.Uuid
  ownerId        String?   @map("owner_id") @db.Uuid
  name           String
  muscleGroupKey String    @map("muscle_group_key")
  equipmentKey   String    @map("equipment_key")
  instructions   String[]
  videoUrl       String?   @map("video_url")
  mediaFileId    String?   @map("media_file_id") @db.Uuid // imagem ou vídeo enviado (files)
  badgeKey       String?   @unique @map("badge_key") // RN10: liga o exercício base aos badges de força
  createdAt      DateTime  @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  owner             User?                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  muscleGroup       MuscleGroup           @relation(fields: [muscleGroupKey], references: [key], onDelete: Restrict)
  equipment         Equipment             @relation(fields: [equipmentKey], references: [key], onDelete: Restrict)
  mediaFile         StoredFile?           @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)
  alternatives      ExerciseAlternative[] @relation("AlternativeOf")
  alternativeTo     ExerciseAlternative[] @relation("AlternativeExercise")
  prescribedItems   PrescribedItem[]
  executedSets      ExecutedSet[]
  substitutions     ExecutedItem[]
  loadConfirmations LoadConfirmation[]

  @@index([ownerId, name])
  @@index([muscleGroupKey])
  @@map("exercises")
}

// Alternativa pré-aprovada para troca na execução. approvedById nulo = alternativa da base
// (seed); com valor, vale só para os alunos daquele treinador.
model ExerciseAlternative {
  id            String   @id @db.Uuid
  exerciseId    String   @map("exercise_id") @db.Uuid
  alternativeId String   @map("alternative_id") @db.Uuid
  approvedById  String?  @map("approved_by_id") @db.Uuid
  createdAt     DateTime @map("created_at") @db.Timestamptz

  exercise    Exercise @relation("AlternativeOf", fields: [exerciseId], references: [id], onDelete: Cascade)
  alternative Exercise @relation("AlternativeExercise", fields: [alternativeId], references: [id], onDelete: Cascade)
  approvedBy  User?    @relation(fields: [approvedById], references: [id], onDelete: Cascade)

  @@index([exerciseId, approvedById])
  @@map("exercise_alternatives")
}

// =====================================================================
// prescription
// =====================================================================

enum MesocycleStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ItemGroupType {
  BISET
  SUPERSET
  CIRCUIT
}

// A ficha. Um mesociclo ACTIVE nunca é editado no lugar (RN05): alterar é clonar em DRAFT e
// ativar, o que arquiva o anterior. Um ACTIVE por aluno: índice parcial em SQL na migração.
// ownerId é o treinador que prescreveu ou o próprio aluno autônomo (RN04).
model Mesocycle {
  id           String          @id @db.Uuid
  ownerId      String          @map("owner_id") @db.Uuid
  studentId    String          @map("student_id") @db.Uuid
  clonedFromId String?         @map("cloned_from_id") @db.Uuid
  name         String
  focus        String?
  startsOn     DateTime?       @map("starts_on") @db.Date
  endsOn       DateTime?       @map("ends_on") @db.Date
  status       MesocycleStatus @default(DRAFT)
  createdAt    DateTime        @map("created_at") @db.Timestamptz
  updatedAt    DateTime        @map("updated_at") @db.Timestamptz
  activatedAt  DateTime?       @map("activated_at") @db.Timestamptz
  archivedAt   DateTime?       @map("archived_at") @db.Timestamptz

  owner      User                @relation("MesocycleOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  student    User                @relation("MesocycleStudent", fields: [studentId], references: [id], onDelete: Restrict)
  clonedFrom Mesocycle?          @relation("MesocycleClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones     Mesocycle[]         @relation("MesocycleClone")
  sessions   PrescribedSession[]

  @@index([studentId, status])
  @@index([ownerId, status])
  @@map("mesocycles")
}

model PrescribedSession {
  id          String  @id @db.Uuid
  mesocycleId String  @map("mesocycle_id") @db.Uuid
  name        String // Treino A, Treino B...
  subtitle    String?
  position    Int // ordem na rotação (order na API)

  mesocycle  Mesocycle         @relation(fields: [mesocycleId], references: [id], onDelete: Cascade)
  items      PrescribedItem[]
  executions ExecutedSession[]

  @@unique([mesocycleId, position])
  @@map("prescribed_sessions")
}

// Limites do RF-W05 (séries 1 a 20, repsMin <= repsMax, descanso 0 a 600 s, cadência de 4
// caracteres 0-9 ou X, observação até 300) são validados no Zod e repetidos em CHECK na migração.
model PrescribedItem {
  id          String         @id @db.Uuid
  sessionId   String         @map("session_id") @db.Uuid
  exerciseId  String         @map("exercise_id") @db.Uuid
  position    Int
  sets        Int
  repsMin     Int            @map("reps_min")
  repsMax     Int            @map("reps_max")
  restSeconds Int            @default(60) @map("rest_seconds")
  cadence     String?
  note        String?
  groupKey    String?        @map("group_key") // liga itens consecutivos do mesmo bloco
  groupType   ItemGroupType? @map("group_type")

  session       PrescribedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise      Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  executedSets  ExecutedSet[]
  executedItems ExecutedItem[]

  @@unique([sessionId, position])
  @@index([exerciseId])
  @@map("prescribed_items")
}

// Estrutura copiada de um mesociclo (sessões e itens, no formato do corpo de POST /mesocycles,
// sem studentId e datas). A cópia é independente: editar a ficha não muda o template, e
// instanciar cria um DRAFT novo (RF-W07).
model Template {
  id          String   @id @db.Uuid
  trainerId   String   @map("trainer_id") @db.Uuid
  name        String
  description String?
  structure   Json
  createdAt   DateTime @map("created_at") @db.Timestamptz
  updatedAt   DateTime @map("updated_at") @db.Timestamptz

  trainer User @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, createdAt])
  @@map("templates")
}

// =====================================================================
// execution
// =====================================================================

enum ExecutedSessionStatus {
  IN_PROGRESS
  FINISHED
}

enum SessionClosedBy {
  STUDENT
  SYSTEM // encerrada pelo servidor após inatividade (sessionAutoCloseInactivityHours)
}

// Sessão executada. O id vem do aparelho (sessionId da mutação SESSION_START, UUID v7).
// Aponta para a sessão prescrita por FK e nunca copia a ficha (RN05). localDate é o dia, no fuso
// do aluno gravado em timezone, em que a sessão começou (ERS 5.5); o instante é startedAt.
// Totais e o resultado para a gamificação são calculados no servidor ao finalizar.
// Uma IN_PROGRESS por aluno: índice parcial em SQL na migração.
model ExecutedSession {
  id                     String                @id @db.Uuid
  studentId              String                @map("student_id") @db.Uuid
  prescribedSessionId    String                @map("prescribed_session_id") @db.Uuid
  status                 ExecutedSessionStatus @default(IN_PROGRESS)
  startedAt              DateTime              @map("started_at") @db.Timestamptz
  lastActivityAt         DateTime              @map("last_activity_at") @db.Timestamptz
  finishedAt             DateTime?             @map("finished_at") @db.Timestamptz
  closedBy               SessionClosedBy?      @map("closed_by")
  timezone               String
  localDate              DateTime              @map("local_date") @db.Date
  rpe                    Int?
  durationSeconds        Int?                  @map("duration_seconds")
  volumeKg               Decimal?              @map("volume_kg") @db.Decimal(10, 2)
  completedSets          Int?                  @map("completed_sets")
  prescribedSets         Int?                  @map("prescribed_sets")
  countedForGamification Boolean?              @map("counted_for_gamification")
  notCountedReason       String?               @map("not_counted_reason") // LESS_THAN_50_PERCENT_SETS, SHORTER_THAN_15_MINUTES
  createdAt              DateTime              @map("created_at") @db.Timestamptz
  updatedAt              DateTime              @map("updated_at") @db.Timestamptz
  deletedAt              DateTime?             @map("deleted_at") @db.Timestamptz // SESSION_DELETE dentro da janela de edição

  student           User              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  prescribedSession PrescribedSession @relation(fields: [prescribedSessionId], references: [id], onDelete: Restrict)
  items             ExecutedItem[]
  sets              ExecutedSet[]
  badgesUnlocked    StudentBadge[]

  // RNF04: histórico e timeline por aluno, mais recentes primeiro. A timeline da carteira busca os
  // 20 mais recentes de cada aluno com CROSS JOIN LATERAL a partir de links e depois corta em 20;
  // juntar tudo antes de ordenar faz o Postgres varrer a tabela inteira.
  @@index([studentId, startedAt])
  @@index([studentId, finishedAt])
  @@map("executed_sessions")
}

// O que o aluno fez com um exercício da ficha além das séries: pulou, trocou por uma alternativa
// aprovada ou deixou observação. O status DONE/PARTIAL é derivado das séries.
model ExecutedItem {
  id                   String   @id @db.Uuid
  sessionId            String   @map("session_id") @db.Uuid
  prescribedItemId     String   @map("prescribed_item_id") @db.Uuid
  skipped              Boolean  @default(false)
  substituteExerciseId String?  @map("substitute_exercise_id") @db.Uuid
  note                 String?
  updatedAt            DateTime @map("updated_at") @db.Timestamptz

  session            ExecutedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  prescribedItem     PrescribedItem  @relation(fields: [prescribedItemId], references: [id], onDelete: Restrict)
  substituteExercise Exercise?       @relation(fields: [substituteExerciseId], references: [id], onDelete: Restrict)

  @@unique([sessionId, prescribedItemId])
  @@map("executed_items")
}

// Série executada. O id vem do aparelho (setId de SET_UPSERT). exerciseId é o exercício feito de
// fato (o substituto, quando houve troca). Carga em kg.
model ExecutedSet {
  id                String   @id @db.Uuid
  sessionId         String   @map("session_id") @db.Uuid
  prescribedItemId  String   @map("prescribed_item_id") @db.Uuid
  exerciseId        String   @map("exercise_id") @db.Uuid
  setNumber         Int      @map("set_number")
  loadKg            Decimal  @map("load_kg") @db.Decimal(6, 2)
  reps              Int
  actualRestSeconds Int?     @map("actual_rest_seconds")
  isExtra           Boolean  @default(false) @map("is_extra")
  completedAt       DateTime @map("completed_at") @db.Timestamptz
  createdAt         DateTime @map("created_at") @db.Timestamptz
  updatedAt         DateTime @map("updated_at") @db.Timestamptz

  session          ExecutedSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  prescribedItem   PrescribedItem    @relation(fields: [prescribedItemId], references: [id], onDelete: Restrict)
  exercise         Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  loadConfirmation LoadConfirmation?

  @@index([sessionId, prescribedItemId, setNumber])
  @@index([exerciseId, completedAt])
  @@map("executed_sets")
}

enum MutationType {
  SESSION_START
  SET_UPSERT
  SET_DELETE
  EXERCISE_NOTE
  EXERCISE_SUBSTITUTE
  EXERCISE_SKIP
  SESSION_FINISH
  SESSION_DELETE
  BODY_MEASUREMENT_ADD
  MESSAGE_SEND
}

enum MutationResult {
  APPLIED
  REJECTED
}

// Chave de idempotência do /sync/push: uma linha por clientMutationId já processado. Reenviar a
// mesma mutação encontra a linha e responde DUPLICATE sem gravar de novo. DEFERRED não é gravado,
// porque a mutação volta depois.
model SyncedMutation {
  clientMutationId String         @id @map("client_mutation_id") @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  deviceId         String         @map("device_id") @db.Uuid // id do aparelho enviado no lote
  type             MutationType
  result           MutationResult
  errorCode        String?        @map("error_code")
  occurredAt       DateTime       @map("occurred_at") @db.Timestamptz
  receivedAt       DateTime       @map("received_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, receivedAt])
  @@map("synced_mutations")
}

// =====================================================================
// gamification
// =====================================================================

// Semana (segunda a domingo) no fuso do aluno, única por aluno e início da semana. goalDays guarda
// a meta vigente quando a semana começou, para que mudar a configuração não reescreva o passado.
// completedAt: quando o aluno atingiu a meta; closedAt: quando o worker fechou a semana.
model WeekProgress {
  id          String    @id @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  weekStart   DateTime  @map("week_start") @db.Date
  timezone    String
  trainedDays Int       @default(0) @map("trained_days")
  goalDays    Int       @map("goal_days")
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  closedAt    DateTime? @map("closed_at") @db.Timestamptz
  updatedAt   DateTime  @map("updated_at") @db.Timestamptz

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, weekStart])
  @@map("week_progress")
}

enum BadgeCategory {
  CONSISTENCY
  VOLUME
  STRENGTH
}

// Catálogo da ERS 5.4. criterion descreve a regra (tipo e parâmetros, ex.: semanas consecutivas,
// volume acumulado, carga mínima num exercício base por badgeKey); o seed preenche.
model Badge {
  key         String        @id // ex.: IRON_ROUTINE
  name        String
  description String
  category    BadgeCategory
  icon        String
  criterion   Json
  sortOrder   Int           @map("sort_order")

  awards StudentBadge[]

  @@map("badges")
}

enum BadgeOriginType {
  SESSION
  WEEK
}

// Badge conquistado. Único por aluno e badge e nunca removido (RN09).
model StudentBadge {
  id              String          @id @db.Uuid
  studentId       String          @map("student_id") @db.Uuid
  badgeKey        String          @map("badge_key")
  unlockedAt      DateTime        @map("unlocked_at") @db.Timestamptz
  originType      BadgeOriginType @map("origin_type")
  originSessionId String?         @map("origin_session_id") @db.Uuid
  originWeekStart DateTime?       @map("origin_week_start") @db.Date

  student       User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge         Badge            @relation(fields: [badgeKey], references: [key], onDelete: Restrict)
  originSession ExecutedSession? @relation(fields: [originSessionId], references: [id], onDelete: SetNull)

  @@unique([studentId, badgeKey])
  @@index([studentId, unlockedAt])
  @@map("student_badges")
}

enum LoadConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// Carga mais de 50% acima do melhor registro anterior fica pendente para os badges de força até o
// aluno confirmar (ERS 5.4). Rejeitar só descarta para a gamificação; a série continua no histórico.
model LoadConfirmation {
  id             String                 @id @db.Uuid
  studentId      String                 @map("student_id") @db.Uuid
  setId          String                 @unique @map("set_id") @db.Uuid
  exerciseId     String                 @map("exercise_id") @db.Uuid
  loadKg         Decimal                @map("load_kg") @db.Decimal(6, 2)
  previousBestKg Decimal                @map("previous_best_kg") @db.Decimal(6, 2)
  status         LoadConfirmationStatus @default(PENDING)
  createdAt      DateTime               @map("created_at") @db.Timestamptz
  resolvedAt     DateTime?              @map("resolved_at") @db.Timestamptz

  student  User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  set      ExecutedSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  exercise Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([studentId, status])
  @@map("load_confirmations")
}

// =====================================================================
// students
// =====================================================================

// Anotações privadas do treinador sobre o aluno; o aluno nunca vê.
model TrainerNote {
  id        String   @id @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  content   String
  createdAt DateTime @map("created_at") @db.Timestamptz
  updatedAt DateTime @map("updated_at") @db.Timestamptz

  trainer User @relation("TrainerNoteAuthor", fields: [trainerId], references: [id], onDelete: Cascade)
  student User @relation("TrainerNoteStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([trainerId, studentId, updatedAt])
  @@map("trainer_notes")
}

// Peso e medidas datados (dado pessoal sensível). Faixas válidas em CHECK na migração.
model BodyMeasurement {
  id             String   @id @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  measuredAt     DateTime @map("measured_at") @db.Timestamptz
  weightKg       Decimal  @map("weight_kg") @db.Decimal(5, 2)
  bodyFatPercent Decimal? @map("body_fat_percent") @db.Decimal(4, 1)
  waistCm        Decimal? @map("waist_cm") @db.Decimal(5, 1)
  armCm          Decimal? @map("arm_cm") @db.Decimal(5, 1)
  thighCm        Decimal? @map("thigh_cm") @db.Decimal(5, 1)
  createdAt      DateTime @map("created_at") @db.Timestamptz

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, measuredAt])
  @@map("body_measurements")
}

// Uma anamnese por aluno; cada salvamento cria uma versão nova e a anterior fica no histórico.
// O conteúdo segue o corpo de PUT /me/anamnesis (objetivo, experiência, saúde, estilo de vida).
model Anamnesis {
  id        String   @id @db.Uuid
  studentId String   @unique @map("student_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz
  updatedAt DateTime @map("updated_at") @db.Timestamptz

  student  User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  versions AnamnesisVersion[]

  @@map("anamneses")
}

model AnamnesisVersion {
  id          String   @id @db.Uuid
  anamnesisId String   @map("anamnesis_id") @db.Uuid
  number      Int
  content     Json
  authorId    String   @map("author_id") @db.Uuid // o aluno ou o treinador vinculado
  createdAt   DateTime @map("created_at") @db.Timestamptz

  anamnesis Anamnesis @relation(fields: [anamnesisId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([anamnesisId, number])
  @@map("anamnesis_versions")
}

enum HealthDataResource {
  ANAMNESIS
  BODY_MEASUREMENTS
  STUDENT_ATTACHMENT
}

// Auditoria de leitura de dados de saúde (RNF05, LGPD): quem leu, de qual aluno, o quê e quando.
// Só recebe inserções; o aluno consulta em GET /me/privacy/access-log.
model HealthDataAccess {
  id         String             @id @db.Uuid
  studentId  String             @map("student_id") @db.Uuid
  readerId   String             @map("reader_id") @db.Uuid
  resource   HealthDataResource
  resourceId String?            @map("resource_id") @db.Uuid
  readAt     DateTime           @map("read_at") @db.Timestamptz

  student User @relation("HealthDataOwner", fields: [studentId], references: [id], onDelete: Cascade)
  reader  User @relation("HealthDataReader", fields: [readerId], references: [id], onDelete: Cascade)

  @@index([studentId, readAt])
  @@map("health_data_access_log")
}

// =====================================================================
// messaging
// =====================================================================

// Uma conversa por vínculo. Vínculo encerrado deixa a conversa somente leitura (409 LINK_NOT_ACTIVE).
model Conversation {
  id            String    @id @db.Uuid
  linkId        String    @unique @map("link_id") @db.Uuid
  trainerId     String    @map("trainer_id") @db.Uuid
  studentId     String    @map("student_id") @db.Uuid
  createdAt     DateTime  @map("created_at") @db.Timestamptz
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz

  link     Link      @relation(fields: [linkId], references: [id], onDelete: Restrict)
  trainer  User      @relation("ConversationTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  student  User      @relation("ConversationStudent", fields: [studentId], references: [id], onDelete: Restrict)
  messages Message[]

  @@index([trainerId, lastMessageAt])
  @@index([studentId, lastMessageAt])
  @@map("conversations")
}

// O id é o messageId gerado no cliente (UUID v7), que também serve de chave de idempotência.
// Texto até 2.000 caracteres; anexo opcional (Sprint 8).
model Message {
  id               String    @id @db.Uuid
  conversationId   String    @map("conversation_id") @db.Uuid
  senderId         String    @map("sender_id") @db.Uuid
  text             String?
  attachmentFileId String?   @map("attachment_file_id") @db.Uuid
  sentAt           DateTime  @map("sent_at") @db.Timestamptz
  readAt           DateTime? @map("read_at") @db.Timestamptz

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  attachmentFile StoredFile?  @relation(fields: [attachmentFileId], references: [id], onDelete: SetNull)

  @@index([conversationId, sentAt])
  @@map("messages")
}

// =====================================================================
// notifications
// =====================================================================

// REST_FINISHED não aparece aqui: é gerada no aparelho, não pela API.
enum NotificationType {
  NEW_MESOCYCLE
  TRAINER_MESSAGE
  WORKOUT_REMINDER
  WEEK_COMPLETED
  STREAK_AT_RISK
  BADGE_UNLOCKED
  STREAK_BROKEN
  STUDENT_MESSAGE
  STUDENT_HIGH_RPE
  STUDENT_PAIN_REPORTED
}

// target diz ao cliente para qual tela navegar ({ screen, params }).
model Notification {
  id        String           @id @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String?
  target    Json
  createdAt DateTime         @map("created_at") @db.Timestamptz
  readAt    DateTime?        @map("read_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// =====================================================================
// files
// =====================================================================

enum FilePurpose {
  EXERCISE_MEDIA // JPG, PNG ou MP4, até 10 MB
  STUDENT_DOCUMENT // PDF, até 10 MB
}

enum FileStatus {
  PENDING // URL de envio emitida, bytes ainda não confirmados
  READY // POST /files/{id}/complete conferiu tipo e tamanho reais
}

// Metadados do objeto no armazenamento S3-compatível; os bytes nunca passam pela API.
model StoredFile {
  id          String      @id @db.Uuid
  ownerId     String      @map("owner_id") @db.Uuid
  purpose     FilePurpose
  status      FileStatus  @default(PENDING)
  storageKey  String      @unique @map("storage_key")
  fileName    String      @map("file_name")
  contentType String      @map("content_type")
  sizeBytes   Int         @map("size_bytes")
  createdAt   DateTime    @map("created_at") @db.Timestamptz
  completedAt DateTime?   @map("completed_at") @db.Timestamptz
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz

  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  exercises       Exercise[]
  attachment      StudentAttachment?
  messageAttached Message[]

  @@index([ownerId, createdAt])
  @@map("files")
}

// Arquivo que o treinador anexou ao aluno. shared = o aluno também vê e baixa.
model StudentAttachment {
  id        String   @id @db.Uuid
  fileId    String   @unique @map("file_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  title     String
  shared    Boolean  @default(false)
  createdAt DateTime @map("created_at") @db.Timestamptz
  updatedAt DateTime @map("updated_at") @db.Timestamptz

  file    StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  student User       @relation("AttachmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  trainer User       @relation("AttachmentTrainer", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([studentId, shared, createdAt])
  @@map("student_attachments")
}

// =====================================================================
// platform (outbox de eventos de domínio, entregue pelo worker via pg-boss)
// =====================================================================

model OutboxEvent {
  id           String    @id @db.Uuid
  type         String
  payload      Json // só ids e fatos, nunca entidades inteiras
  occurredAt   DateTime  @map("occurred_at") @db.Timestamptz
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz
  attempts     Int       @default(0)

  @@index([dispatchedAt, occurredAt])
  @@map("outbox_events")
}
